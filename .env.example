# ─────────────────────────────────────────────────────────────
# NitiDrishti — environment template
# Copy to .env and fill real values. NEVER commit .env
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
APP_NAME=NitiDrishti
APP_ENV=development            # development | testing | staging | production
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# ── Backend (FastAPI) ────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_PREFIX=/api
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# ── Database (PostgreSQL + PostGIS) ──────────────────────────
POSTGRES_USER=nitidrishti
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=nitidrishti_dev
POSTGRES_HOST=localhost        # inside docker-compose use: postgres
POSTGRES_PORT=5432
# Full URL is derived from the parts above; override only if needed
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# ── Security (used from Phase 4 onward) ──────────────────────
JWT_SECRET_KEY=generate_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Ingestion (Phase 6 onward) ───────────────────────────────
# Only official government domains may be added here.
INGESTION_ALLOWED_DOMAINS=myscheme.gov.in,scholarships.gov.in,ugc.gov.in,aicte-india.org,india.gov.in
INGESTION_USER_AGENT=NitiDrishti-AcademicResearchBot/0.1 (+contact: your-email@example.com)
INGESTION_REQUEST_TIMEOUT=30
INGESTION_MAX_RETRIES=3
INGESTION_MAX_FILE_MB=25
RAW_STORAGE_PATH=./storage/raw

# ── Local AI (Phase 13 onward) — local models only, no paid API ──
AI_PROVIDER=local              # local | ollama | none
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AI_CONFIDENCE_THRESHOLD=0.75
TESSERACT_CMD=tesseract
OCR_LANGUAGES=eng+hin

# ── Frontend (Next.js) ───────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_DEFAULT_LOCALE=en
