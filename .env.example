# ─────────────────────────────────────────────────────────────
# NitiDrishti — environment template
# Copy to .env and fill real values. NEVER commit .env
# Keys below match backend/app/config.py Settings unless marked UNUSED.
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
APP_NAME=NitiDrishti
APP_ENV=development            # development | testing | staging | production
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# ── Backend (FastAPI) ────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_PREFIX=/api
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# ── Database (native PostgreSQL) ─────────────────────────────
# REQUIRED for local Option A — Settings builds the URL from these parts.
# Documented local database name on this project: nitidrishti_db
# Settings code fallback if POSTGRES_DB is unset: nitidrishti_dev
POSTGRES_USER=nitidrishti
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=nitidrishti_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# OPTIONAL override (Settings field alias DATABASE_URL). When set, it replaces
# POSTGRES_* above. Paste a managed provider string as given; driver + sslmode
# are added automatically. Leave commented for local Postgres (POSTGRES_* above).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/nitidrishti_db
#
# After setting it, enable the extensions once:
#   cd backend; python -m scripts.init_extensions
# Required extensions: pg_trgm, unaccent. PostGIS and pgvector are optional/future
# and are NOT required (maps use bundled TopoJSON; embeddings have no VECTOR column).

# ── Security ─────────────────────────────────────────────────
# Placeholders only. Copy to .env and replace. NEVER commit .env
JWT_SECRET_KEY=generate_a_long_random_string_32b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Ingestion ────────────────────────────────────────────────
# Only official government domains may be added here.
INGESTION_ALLOWED_DOMAINS=myscheme.gov.in,vikaspedia.in,en.vikaspedia.in,dbtbharat.gov.in,scholarships.gov.in,ugc.gov.in,aicte-india.org,india.gov.in
INGESTION_USER_AGENT=NitiDrishtiBot/0.1
INGESTION_REQUEST_TIMEOUT=30
INGESTION_MAX_RETRIES=3
INGESTION_MAX_FILE_MB=25
INGESTION_CRAWL_DELAY_SECONDS=1
# Backend process includes scheduled catalogue refresh (INGEST_INTERVAL_HOURS, default 24).
# Alias also accepted: INGEST_SCHEDULE_ENABLED. Off under pytest / APP_ENV=testing.
INGEST_SCHEDULER_ENABLED=true
INGEST_INTERVAL_HOURS=24
RAW_STORAGE_PATH=./storage/raw

# ── Feature flags ────────────────────────────────────────────
# Scanned gazette OCR. false = fail-closed (default in code). true only if Tesseract is installed.
FEATURE_AI_EXTRACTION=false
# Catalog disaster DSS on /welfare and /analytics. Default off. true = published disaster-sector rows only (not NDMA live, not PostGIS).
FEATURE_DISASTER_MODULE=false
FEATURE_WHAT_IF_API=true

# ── Rate limit (in-process; off under pytest / APP_ENV=testing) ─
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=20
RATE_LIMIT_ELIGIBILITY_PER_MINUTE=60
RATE_LIMIT_SEARCH_PER_MINUTE=60

# ── OCR (optional extras + Tesseract binary; fail-closed if missing) ─
# pip install pytesseract pillow pymupdf  (optional; not required to boot)
TESSERACT_CMD=tesseract
OCR_LANGUAGES=eng+hin
OCR_MIN_TEXT_CHARS=12
OCR_MAX_PAGES=4

# Operator accounts (idempotent). Register stays CITIZEN. Copy to .env and change.
# python -m scripts.bootstrap_operators
BOOTSTRAP_OFFICER_EMAIL=officer@nitidrishti.local
BOOTSTRAP_OFFICER_PASSWORD=change_me_officer_12
BOOTSTRAP_ADMIN_EMAIL=admin@nitidrishti.local
BOOTSTRAP_ADMIN_PASSWORD=change_me_admin_12
BOOTSTRAP_CSC_EMAIL=csc@nitidrishti.local
BOOTSTRAP_CSC_PASSWORD=change_me_csc_12

# UNUSED by current Settings / backend code (no Ollama, embeddings, or paid AI client):
# AI_PROVIDER, OLLAMA_BASE_URL, OLLAMA_MODEL, EMBEDDING_MODEL, AI_CONFIDENCE_THRESHOLD

# ── Frontend (Next.js) — copy these into frontend/.env.local ─
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_DEFAULT_LOCALE=en
# Catalog snapshot SW on /schemes and /citizen. false keeps the worker unregistered.
NEXT_PUBLIC_FEATURE_OFFLINE_CATALOG=true
